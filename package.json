{
  "name": "git-buttons",
  "displayName": "GIT Buttons",
  "description": "Command bar with quick Git actions: fetch all remotes and prune stale local branches.",
  "version": "0.0.1",
  "publisher": "ai-team-26",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "gitButtons.fetch",
        "title": "GIT: Fetch"
      },
      {
        "command": "gitButtons.pruneLocalBranches",
        "title": "GIT: Prune Local Branches"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -watch -p .",
    "package": "vsce package",
    "lint": "eslint src/",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "check": "npm run lint && npm run format:check"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.1.0",
    "eslint": "^10.12.0",
    "prettier": "^3.9.10",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.71.2"
  }
}